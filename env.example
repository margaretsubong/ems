# ==========================================
# APPLICATION
# ==========================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# SUPABASE
# ==========================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-side only: privileged operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ==========================================
# BREVO TRANSACTIONAL EMAIL
# ==========================================

# Brevo API Key (server-side only)
BREVO_API_KEY=your_brevo_api_key

# Verified sender identity
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=EMS

# Optional: Brevo email template IDs
BREVO_ACTIVATION_TEMPLATE_ID=
BREVO_PASSWORD_RESET_TEMPLATE_ID=
BREVO_WELCOME_TEMPLATE_ID=